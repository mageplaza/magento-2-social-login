<script>
    function initMyForm() {
        return {
            myFormSubmit(event) {
                event.preventDefault();

                this.validate()
                .then(() => {
                    // all fields validated
                    let form = event.target;
                    const formData = new FormData(form);
                    fetch('<?= /** @noEscape */ $block->getUrl('sociallogin/social/email') ?>', {
                        method: 'POST',
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: formData
                    }).then(res => {
                        return res.json()
                    }).then(response=>{
                        if (!response.url) {
                            window.location.reload();
                        } else {
                            window.location.href = response.url;
                        }

                    }).catch(e => {

                    })
                    // event.target.submit()
                })
                .catch((invalid) => {
                    if (invalid.length > 0) {
                        invalid[0].focus();
                    }
                });
            }
        }
    }
</script>
<?php endif; ?>
